{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Key System Performance & Health KPIs",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Created",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(notifications_created_total) or vector(0)",
          "legendFormat": "Created"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Total Delivered (Success)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(notifications_delivered_total) or vector(0)",
          "legendFormat": "Delivered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "title": "Total DLQ (Dead Letter)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(notifications_dlq_current_total) or sum(notifications_dlq_total) or vector(0)",
          "legendFormat": "DLQ in DB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Rate Limit Throttled",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(notifications_throttled_total) or vector(0)",
          "legendFormat": "Throttled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max(circuit_breaker_state) or vector(0)",
          "legendFormat": "State"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "🟢 CLOSED (OK)", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "🟡 HALF_OPEN (Probe)", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "🔴 OPEN (Trip)", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📈 Multi-Priority Traffic & Delivery Throughput",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Ingestion Rate by Priority (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (priority) (rate(notifications_created_total[1m]))",
          "legendFormat": "{{priority}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "title": "Delivery Rate by Channel (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (channel) (rate(notifications_delivered_total[1m]))",
          "legendFormat": "{{channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🛡️ Resilience, Latency & Error Tracking",
      "type": "row"
    },
    {
      "id": 8,
      "title": "Provider Delivery Latency (P95 & Average)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(provider_delivery_duration_seconds_sum[1m]) / rate(provider_delivery_duration_seconds_count[1m])",
          "legendFormat": "{{provider}} (avg sec)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      }
    },
    {
      "id": 9,
      "title": "Dead Letter Queue (DLQ) Routing Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (reason) (rate(notifications_dlq_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50
          },
          "unit": "short"
        }
      }
    }
  ],
