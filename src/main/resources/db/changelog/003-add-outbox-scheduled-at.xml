<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ChangeSet 1: Add scheduled_at to outbox_events for delayed retry -->
    <changeSet id="003-add-outbox-scheduled-at" author="notification-platform">
        <addColumn tableName="outbox_events">
            <column name="scheduled_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </addColumn>

        <createIndex tableName="outbox_events" indexName="idx_outbox_events_status_scheduled_at">
            <column name="status"/>
            <column name="scheduled_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
