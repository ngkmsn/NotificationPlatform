<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ChangeSet 1: Create providers table -->
    <changeSet id="001-create-providers-table" author="notification-platform">
        <createTable tableName="providers">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_providers"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="channel" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="rate_limit" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="providers" indexName="idx_providers_channel">
            <column name="channel"/>
        </createIndex>
        <createIndex tableName="providers" indexName="idx_providers_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- ChangeSet 2: Update notifications table -->
    <changeSet id="002-update-notifications-table" author="notification-platform">
        <addColumn tableName="notifications">
            <column name="provider_id" type="UUID">
                <constraints foreignKeyName="fk_notifications_provider" references="providers(id)"/>
            </column>
            <column name="retry_count" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <createIndex tableName="notifications" indexName="idx_notifications_priority">
            <column name="priority"/>
        </createIndex>
        <createIndex tableName="notifications" indexName="idx_notifications_provider_id">
            <column name="provider_id"/>
        </createIndex>
        <createIndex tableName="notifications" indexName="idx_notifications_status_priority_created">
            <column name="status"/>
            <column name="priority"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- ChangeSet 3: Update notification_attempts table -->
    <changeSet id="003-update-notification-attempts-table" author="notification-platform">
        <addColumn tableName="notification_attempts">
            <column name="provider_id" type="UUID">
                <constraints foreignKeyName="fk_attempts_provider" references="providers(id)"/>
            </column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>

        <renameColumn tableName="notification_attempts"
                      oldColumnName="created_at"
                      newColumnName="attempted_at"
                      columnDataType="TIMESTAMP WITH TIME ZONE"/>

        <createIndex tableName="notification_attempts" indexName="idx_attempts_provider_id">
            <column name="provider_id"/>
        </createIndex>
        <createIndex tableName="notification_attempts" indexName="idx_attempts_attempted_at">
            <column name="attempted_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
